+static bool tts_write_frame(char type, const char * data = nullptr, uint64_t size = 0) {
+    uint8_t header[9] = { (uint8_t) type };
+    for (int i = 0; i < 8; ++i) {
+        header[i + 1] = (uint8_t) ((size >> (i * 8)) & 0xff);
+    }
+    if (fwrite(header, 1, sizeof(header), stdout) != sizeof(header)) {
+        return false;
+    }
+    if (size > 0 && fwrite(data, 1, size, stdout) != size) {
+        return false;
+    }
+    return fflush(stdout) == 0;
+}
