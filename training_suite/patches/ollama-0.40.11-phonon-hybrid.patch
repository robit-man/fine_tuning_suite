diff --git a/mlxrunner/hybrid.go b/mlxrunner/hybrid.go
new file mode 100644
index 0000000..18722f5
--- /dev/null
+++ b/mlxrunner/hybrid.go
@@ -0,0 +1,110 @@
+package mlxrunner
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log/slog"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+
+	"github.com/ollama/ollama/llm"
+	"github.com/ollama/ollama/manifest"
+	"github.com/ollama/ollama/ml"
+	"github.com/ollama/ollama/types/model"
+)
+
+func (c *Client) SupportsReferenceAudio() bool { return c.hybrid }
+
+// loadHybrid starts a supervised runner from the requested tag's actual tensor
+// and metadata blobs. It never forwards to an independently configured service.
+func (c *Client) loadHybrid(ctx context.Context) ([]ml.DeviceID, error) {
+	python := os.Getenv("OLLAMA_PHONON_HYBRID_PYTHON")
+	if python == "" {
+		return nil, errors.New("PhononHybrid requires OLLAMA_PHONON_HYBRID_PYTHON pointing to its installed runtime interpreter")
+	}
+	mf, err := manifest.ParseNamedManifest(model.ParseName(c.modelName))
+	if err != nil {
+		return nil, err
+	}
+	dir, err := os.MkdirTemp("", "ollama-phonon-hybrid-")
+	if err != nil {
+		return nil, err
+	}
+	c.hybridDirectory = dir
+	tensors := []map[string]string{}
+	seen := map[string]bool{}
+	for _, layer := range mf.Layers {
+		path, err := manifest.BlobsPath(layer.Digest)
+		if err != nil {
+			return nil, err
+		}
+		if layer.MediaType == manifest.MediaTypeImageTensor {
+			if !seen[layer.Digest] {
+				tensors = append(tensors, map[string]string{"path": path, "digest": layer.Digest})
+				seen[layer.Digest] = true
+			}
+		} else if layer.MediaType == manifest.MediaTypeImageJSON {
+			if !filepath.IsLocal(layer.Name) {
+				return nil, fmt.Errorf("invalid hybrid asset path %q", layer.Name)
+			}
+			target := filepath.Join(dir, filepath.FromSlash(layer.Name))
+			if err := os.MkdirAll(filepath.Dir(target), 0700); err != nil {
+				return nil, err
+			}
+			if err := os.Symlink(path, target); err != nil {
+				return nil, err
+			}
+		}
+	}
+	data, err := json.Marshal(map[string]any{"model": c.modelName, "directory": dir, "tensor_blobs": tensors})
+	if err != nil {
+		return nil, err
+	}
+	descriptor := filepath.Join(dir, "ollama-runner.json")
+	if err := os.WriteFile(descriptor, data, 0600); err != nil {
+		return nil, err
+	}
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		return nil, err
+	}
+	c.port = listener.Addr().(*net.TCPAddr).Port
+	_ = listener.Close()
+	cmd := exec.Command(python, "-m", "training_suite.phonon_ollama_runner", "--descriptor", descriptor, "--port", strconv.Itoa(c.port))
+	cmd.Env = os.Environ()
+	// The first hybrid implementation is a CPU runner, including when the
+	// parent Ollama server has CUDA lanes for unrelated model architectures.
+	for _, key := range []string{"CUDA_VISIBLE_DEVICES", "HIP_VISIBLE_DEVICES", "ROCR_VISIBLE_DEVICES"} {
+		setEnv(cmd, key, "-1")
+	}
+	setEnv(cmd, "HF_HUB_OFFLINE", "1")
+	setEnv(cmd, "TOKENIZERS_PARALLELISM", "false")
+	if root := os.Getenv("OLLAMA_PHONON_HYBRID_ROOT"); root != "" {
+		cmd.Dir = root
+	}
+	status := llm.NewStatusWriter(os.Stderr)
+	cmd.Stdout, cmd.Stderr = status, status
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed {
+		return nil, errors.New("hybrid runner client is closed")
+	}
+	c.status = status
+	if err := cmd.Start(); err != nil {
+		return nil, err
+	}
+	if err := llm.AddRunnerToJob(cmd.Process.Pid); err != nil {
+		_ = cmd.Process.Kill()
+		_ = cmd.Wait()
+		return nil, err
+	}
+	c.cmd = cmd
+	slog.Info("starting Ollama-managed Phonon hybrid runner", "model", c.modelName, "pid", cmd.Process.Pid, "port", c.port)
+	go func() { c.doneErr = cmd.Wait(); close(c.done) }()
+	return nil, nil
+}
