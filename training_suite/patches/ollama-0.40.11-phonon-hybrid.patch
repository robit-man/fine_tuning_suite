+package server
+
+import (
+	"context"
+	"testing"
+
+	"github.com/ollama/ollama/manifest"
+	"github.com/ollama/ollama/types/model"
+)
+
+func TestPhononHybridPullDoesNotRequireMLX(t *testing.T) {
+	layers := []manifest.Layer{{MediaType: manifest.MediaTypeImageTensor}}
+	if requiresMLX(&manifest.Manifest{Runner: manifest.RunnerPhononHybrid, Layers: layers}) {
+		t.Fatal("CPU hybrid pull must not initialize MLX")
+	}
+	if !requiresMLX(&manifest.Manifest{Runner: manifest.RunnerMLX, Layers: layers}) {
+		t.Fatal("MLX pull must retain its runtime check")
+	}
+}
+
+func TestPhononHybridAppearsInModelList(t *testing.T) {
+	t.Setenv("OLLAMA_MODELS", t.TempDir())
+	writeShowManifestVariant(t, "hybrid-list", manifest.RunnerPhononHybrid, manifest.FormatSafetensors,
+		model.ConfigV2{ModelFormat: "safetensors", ModelFamily: "phonon_hybrid"}, nil)
+	rows, err := listModels(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rows) != 1 || rows[0].Details.Runner != manifest.RunnerPhononHybrid {
+		t.Fatalf("hybrid must remain visible in /api/tags: %+v", rows)
+	}
+}
