+package create
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"github.com/ollama/ollama/manifest"
+	"github.com/ollama/ollama/types/model"
+)
+
+func TestPhononHybridImportCapabilitiesAndNestedAssets(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "config.json"), []byte(`{"architectures":["PhononHybrid"],"model_type":"phonon_hybrid"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Join(dir, "asr_processor"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "asr_processor", "processor_config.json"), []byte(`{}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, _, err := readSourceModelConfig(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	metadata, err := inferSafetensorsConfig(dir, cfg, "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, cap := range []string{"speech", "completion", "audio"} {
+		if !slices.Contains(metadata.Capabilities, cap) {
+			t.Fatalf("missing %s", cap)
+		}
+	}
+	if metadata.ModelFamily != "phonon_hybrid" {
+		t.Fatal(metadata)
+	}
+	if err := validateMLXSource(cfg, false, MLXValidationOptions{}); err != nil {
+		t.Fatal(err)
+	}
+	files, err := SafetensorsConfigFiles(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !slices.Contains(files, "asr_processor/processor_config.json") {
+		t.Fatal(files)
+	}
+}
+
+func TestPhononHybridManifestUsesIndependentRunner(t *testing.T) {
+	t.Setenv("OLLAMA_MODELS", t.TempDir())
+	write := NewSafetensorsManifestWriter(SafetensorsManifestOptions{MinVersion: "0.40.11"})
+	if err := write(context.Background(), "hybrid-test", ManifestInfo{ModelConfig: model.ConfigV2{ModelFamily: "phonon_hybrid"}}); err != nil {
+		t.Fatal(err)
+	}
+	m, err := manifest.ParseNamedManifest(model.ParseName("hybrid-test"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m.Runner != manifest.RunnerPhononHybrid || m.Format != manifest.FormatSafetensors {
+		t.Fatalf("hybrid metadata: runner=%s format=%s", m.Runner, m.Format)
+	}
+}
